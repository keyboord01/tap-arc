# Which network the app talks to: testnet | mainnet | local
NEXT_PUBLIC_CHAIN=testnet

# Address of the deployed Tap contract on that network.
# Leave empty to show the "contract not configured" screen.
NEXT_PUBLIC_TAP_ADDRESS=

# Optional: block number the contract was deployed in. The activity feed stops scanning there.
NEXT_PUBLIC_TAP_DEPLOY_BLOCK=

# Optional RPC overrides (defaults shown). Use a private provider URL if you have one.
# NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_TESTNET_WS_URL=wss://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Local development only (NEXT_PUBLIC_CHAIN=local): anvil RPC and mock USDC address.
# NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_USDC_ADDRESS=
